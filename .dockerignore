# В build context входят только явно разрешённые файлы проекта.
**
!Dockerfile
!compose.yaml
!.dockerignore
!requirements.txt
!README.md
!src/
!src/**
!app/
!app/**
!tests/
!tests/**
!docs/
!docs/**

# Только рецепт модели: бинарный joblib будет восстановлен в named volume.
!models/
models/**
!models/fraud_pipeline.json
!models/selection_lock.json

# Сохранённые агрегаты и синтетический пример для экрана защиты.
!reports/
reports/**
!reports/data_audit.json
!reports/split_summary.json
!reports/experiments/
reports/experiments/**
!reports/experiments/data_checks.json
!reports/experiments/data_source.json
!reports/experiments/comparison.csv
!reports/experiments/summary.json
!reports/experiments/handoff_verification.json
!reports/experiments/synthetic_prediction_check.json
!reports/experiments/figures/
reports/experiments/figures/**
!reports/experiments/figures/*.png
!reports/experiments/evaluation/
reports/experiments/evaluation/**
!reports/experiments/evaluation/*.json
!reports/experiments/evaluation/figures/
!reports/experiments/evaluation/figures/*.png

# Даже внутри разрешённых каталогов не передаём окружения, секреты и caches.
**/.git/
**/.venv/
**/venv/
**/__pycache__/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.env
**/.env.*
**/.aws/
**/.codex/
**/.agents/
**/*.py[cod]
**/*.joblib
**/*.pkl
**/*.pickle
**/*.parquet
**/*.db
**/*.sqlite
**/*.sqlite3
**/*.csv
!reports/experiments/comparison.csv
!reports/experiments/evaluation/permutation_importance_validation.csv
DIAS_ML_REPORT.md
